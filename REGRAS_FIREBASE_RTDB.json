{
  "rules": {
    "posts": {
      ".read": "auth != null",
      "$archiveId": {
        ".write": "auth != null && (!data.exists() || data.child('authorAuthUid').val() === auth.uid)"
      }
    },
    "post_payloads": {
      ".read": "auth != null",
      "$archiveId": {
        ".write": "auth != null"
      }
    },
    "audiocasts": {
      ".read": "auth != null",
      "$archiveId": {
        ".write": "auth != null && (!data.exists() || data.child('authorAuthUid').val() === auth.uid)"
      }
    },
    "audiocast_streams": {
      ".read": "auth != null",
      "$archiveId": {
        ".write": "auth != null"
      }
    },
    "auth_identities": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null",
      "$handleKey": {
        ".write": "auth != null && (!data.exists() || data.child('authUid').val() === auth.uid)"
      }
    },
    "social_graph": {
      ".read": "auth != null",
      "$handleKey": {
        ".write": "auth != null"
      }
    },
    "creator_metrics_v2": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "custody_audit_log": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
